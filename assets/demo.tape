# Charmbracelet VHS tape for adversarial-skeptic demo
# Run: vhs assets/demo.tape

Output assets/demo.gif
Output assets/demo.svg

Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 750
Set LineHeight 1.2
Set Padding 20
Set Theme "Catppuccin Mocha"
Set PlaybackSpeed 1.0

Type "npm run demo"
Sleep 500ms
Enter

Sleep 8s
